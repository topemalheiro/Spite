[Desktop Entry]
Name=@PROGRAM_NAME@
Comment=@PROGRAM_NAME@ Digital Audio Workstation
Exec=@ARDOUR_EXEC@
Icon=@ARDOUR_ICON@
Terminal=false
MimeType=application/x-ardour;
Type=Application
Categories=AudioVideo;Audio;AudioEditing;X-Recorders;X-Multitrack;X-Jack;
StartupWMClass=@PROGRAM_NAME@
X-NSM-Capable=true
X-NSM-Exec=@ARDOUR_EXEC@
