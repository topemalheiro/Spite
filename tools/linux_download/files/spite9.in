#!/bin/sh
# Starts Spite from this folder, wherever it is (Spite's Linux download).

# Programs that Spite starts, like a web browser, get the environment Spite was started with,
# not the one set below
export PREBUNDLE_ENV="$(env)"

BIN_DIR=$(dirname "$(readlink -f "$0")")
INSTALL_DIR=$(dirname "$BIN_DIR")

# Spite then finds its files, settings and plugins in this folder
export ARDOUR_BUNDLED=true
export ARDOUR_SELF=$(basename "$0")
export GTK_PATH="$INSTALL_DIR/etc:$INSTALL_DIR/lib"
export GTK_MODULES=""
export UBUNTU_MENUPROXY=""
export VAMP_PATH="$INSTALL_DIR/lib/vamp${VAMP_PATH:+:$VAMP_PATH}"
. "$INSTALL_DIR/lib/fallback/paths.sh"
export LD_LIBRARY_PATH="$INSTALL_DIR/lib$(spite_fallback_path "$INSTALL_DIR")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# The LV2 library in this download only knows Debian's plugin folders; add the other usual ones
export LV2_PATH="${LV2_PATH:-$HOME/.lv2:/usr/local/lib/lv2:/usr/local/lib64/lv2:/usr/lib/lv2:/usr/lib64/lv2:/usr/lib/x86_64-linux-gnu/lv2}"

# PipeWire 1.1 to 1.5 needs this for MIDI through JACK, as in Ardour's own downloads
if command -v pipewire >/dev/null 2>&1; then
	case "$(pipewire --version 2>/dev/null | tail -1 | sed 's/^[^0-9]*//')" in
	1.[1-5].*) export PIPEWIRE_MIDI_BROKEN=1 ;;
	esac
fi

if [ "$(ulimit -l)" != "unlimited" ]; then
	echo "Spite: your system limits how much memory a program may lock, which realtime audio needs." >&2
	echo "       Joining your distribution's 'audio' or 'realtime' group usually lifts the limit." >&2
fi

case "${1:-}" in
-g|--gdb) shift; exec gdb --args "$INSTALL_DIR/lib/ardour-@VERSION@" "$@" ;;
esac
exec "$INSTALL_DIR/lib/ardour-@VERSION@" "$@"
